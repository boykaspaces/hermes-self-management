+    )
+    monkeypatch.setattr(ip, "iron_proxy_version", lambda b: "test")
+    monkeypatch.setattr(
+        ip,
+        "ensure_ca_cert",
+        lambda **kw: (hermes_home / "ca.crt", hermes_home / "ca.key"),
+    )
+    monkeypatch.setattr(
+        ip,
+        "write_proxy_config",
+        lambda config: pytest.fail("invalid allowlist-only config was written"),
+    )
+
+    assert proxy_cli.cmd_setup(_args(allowlist_only=True)) == 1
+
+
