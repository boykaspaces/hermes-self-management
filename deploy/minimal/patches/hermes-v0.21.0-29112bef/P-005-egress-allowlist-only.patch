+def test_cmd_setup_allowlist_only_uses_only_explicit_hosts(hermes_home, monkeypatch):
+    from hermes_cli.config import load_config, save_config
+
+    cfg = load_config()
+    cfg.setdefault("proxy", {})["extra_allowed_hosts"] = [
+        "github.com",
+        "objects.githubusercontent.com",
+        "github.com",
+    ]
+    save_config(cfg)
+
+    monkeypatch.setattr(
+        ip, "find_iron_proxy", lambda **kw: hermes_home / "iron-proxy"
+    )
+    monkeypatch.setattr(ip, "iron_proxy_version", lambda b: "test")
+    monkeypatch.setattr(
+        ip,
+        "ensure_ca_cert",
+        lambda **kw: (hermes_home / "ca.crt", hermes_home / "ca.key"),
+    )
+    monkeypatch.setattr(ip, "get_status", lambda: ip.ProxyStatus())
+    monkeypatch.setattr(
+        ip,
+        "discover_provider_mappings",
+        lambda **kw: pytest.fail("allowlist-only must not discover provider keys"),
+    )
+
+    captured = {}
+    real_build = ip.build_proxy_config
+
+    def capture_build(**kwargs):
+        captured.update(kwargs)
+        return real_build(**kwargs)
+
+    monkeypatch.setattr(ip, "build_proxy_config", capture_build)
+
+    rc = proxy_cli.cmd_setup(_args(allowlist_only=True, restart=False))
+
+    assert rc == 0
+    assert captured["mappings"] == []
+    assert captured["allowed_hosts"] == [
+        "github.com",
+        "objects.githubusercontent.com",
+    ]
+    assert ip.load_mappings() == []
+    assert load_config()["proxy"]["allowlist_only"] is True
+
+
