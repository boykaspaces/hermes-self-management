+@pytest.mark.parametrize(
+    ("docker_exe", "proxy_host", "expected_host_args"),
+    [
+        (
+            "/usr/bin/docker",
+            "host.docker.internal",
+            ["--add-host", "host.docker.internal:host-gateway"],
+        ),
+        (
+            "/usr/bin/podman",
+            "10.0.2.2",
+            ["--network=slirp4netns:allow_host_loopback=true"],
+        ),
+    ],
+)
+def test_allowlist_only_egress_accepts_empty_mappings(
+    monkeypatch, tmp_path, docker_exe, proxy_host, expected_host_args,
+):
+    from agent.proxy_sources import iron_proxy as ip
+    from hermes_cli import config as hermes_config
+
+    config_path = tmp_path / "proxy.yaml"
+    ca_path = tmp_path / "ca.crt"
+    config_path.write_text("transforms: []\n", encoding="utf-8")
+    ca_path.write_text("test-ca\n", encoding="utf-8")
+    monkeypatch.setattr(
+        hermes_config,
+        "load_config",
+        lambda: {
+            "proxy": {
+                "enabled": True,
+                "enforce_on_docker": True,
+                "allowlist_only": True,
+            }
+        },
+    )
+    monkeypatch.setattr(
+        ip,
+        "get_status",
+        lambda: ip.ProxyStatus(
+            enabled=True,
+            config_path=config_path,
+            ca_cert_path=ca_path,
+            pid=123,
+            listening=True,
+            tunnel_port=9090,
+        ),
+    )
+    monkeypatch.setattr(ip, "load_mappings", lambda: [])
+    monkeypatch.setattr(docker_env, "find_docker", lambda: docker_exe)
+
+    volume_args, env_overrides, host_args = (
+        docker_env._egress_proxy_args_for_docker()
+    )
+
+    assert volume_args == [
+        "-v", f"{ca_path}:/etc/ssl/certs/hermes-egress-ca.crt:ro",
+    ]
+    assert env_overrides["HERMES_EGRESS_PROXY"] == "1"
+    assert env_overrides["HTTPS_PROXY"] == f"http://{proxy_host}:9090"
+    assert not any(
+        key.startswith("HERMES_PROXY_TOKEN_") for key in env_overrides
+    )
+    assert host_args == expected_host_args
+
+
+def test_podman_egress_preserves_network_none(monkeypatch):
