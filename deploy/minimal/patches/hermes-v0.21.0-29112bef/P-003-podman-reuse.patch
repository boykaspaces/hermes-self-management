     return cleaned
 
 
+def _ps_label_value(raw_labels: str, key: str) -> Optional[str]:
+    """Read *key* from Docker or Podman ``ps --format {{.Labels}}`` output.
+
+    Docker renders labels as ``key=value,key2=value2`` while Podman 4.x
+    renders a Go map literal (``map[key:value key2:value2]``). Hermes label
+    keys and values are sanitized, so splitting these two stable shapes is
+    sufficient and avoids Docker's unsupported-on-Podman ``.Label`` helper.
+    """
+    raw = raw_labels.strip()
+    if not raw or raw == "<no value>":
+        return None
+    if raw.startswith("map[") and raw.endswith("]"):
+        entries = raw[4:-1].split()
+        separator = ":"
+    else:
+        entries = raw.split(",")
+        separator = "="
+    for entry in entries:
+        label_key, found, value = entry.partition(separator)
+        if found and label_key == key:
+            return value
+    return None
+
+
