diff --git a/tools/environments/docker.py b/tools/environments/docker.py
index 469221c91d..6552762d4c 100644
--- a/tools/environments/docker.py
+++ b/tools/environments/docker.py
@@ -49,1 +49,20 @@ _EGRESS_LABEL_KEY = "hermes-egress"
+def _docker_volume_destination(volume: str) -> str | None:
+    """Return the container path from a Docker ``-v`` specification.
+
+    Docker volume strings are ``source:destination[:options]``. A Windows
+    drive prefix adds one more colon to the source, so use the final absolute
+    path when it is present instead of assuming a fixed number of fields.
+    Empty fields are malformed and must not acquire workspace-replacement
+    semantics before Docker rejects the full specification.
+    """
+    fields = volume.rsplit(":", 2)
+    if len(fields) < 2 or any(not field for field in fields):
+        return None
+    if len(fields) == 2:
+        return fields[1]
+    if fields[2].startswith("/"):
+        return fields[2]
+    return fields[1]
+
+
